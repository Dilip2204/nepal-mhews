# Copy to backend/.env (git-ignored) or export before starting the API.
# Local Ollama (offline AI second opinion). Use a LOCAL model, never a "-cloud" one.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# =============================================================================
# Weekly AI Audit — dual-model consensus (Gemini + Claude)
# =============================================================================
# Both keys are required for DUAL_CONSENSUS mode. With only one present the
# audit degrades to that single engine; with neither it runs deterministic
# (offline, zero-token) and writes nothing to the training catalog.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_MODEL=gemini-3.8-flash
# Only needed if your Anthropic key is ORGANIZATION-scoped rather than workspace-scoped.
# Symptom when missing: every call fails 400 "This API key is not scoped to a workspace".
# Either paste the workspace id here, or create a workspace-scoped key and leave this blank.
ANTHROPIC_WORKSPACE_ID=
# 1 = a bulletin becomes a training label only if BOTH models agree.
AUDIT_REQUIRE_DUAL_CONSENSUS=1
# 1 = stage hardcoded demo bulletins. MUST stay 0 in production — these
# contaminated the training catalog previously.
MHEWS_SEED_DEMO=0

# =============================================================================
# Emergency alert dispatch (fires on ORANGE/RED transitions)
# =============================================================================
MHEWS_ALERTS_ENABLED=0
MHEWS_ALERT_MIN_LEVEL=ORANGE
MHEWS_ALERT_COOLDOWN_MIN=180
# Generic JSON webhook (Slack/Teams/custom endpoint)
MHEWS_ALERT_WEBHOOK_URL=
# Telegram: create a bot via @BotFather, then get the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email (SMTP)
MHEWS_ALERT_EMAIL_TO=
MHEWS_ALERT_EMAIL_FROM=mhews@localhost
MHEWS_SMTP_HOST=
MHEWS_SMTP_PORT=587
MHEWS_SMTP_USER=
MHEWS_SMTP_PASSWORD=

# =============================================================================
# Copernicus Data Space Ecosystem — real Sentinel-1 InSAR creep
# =============================================================================
# Register free at https://dataspace.copernicus.eu/ then create an OAuth client.
CDSE_ENABLED=0
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# =============================================================================
# ASF HyP3 — on-demand Sentinel-1 InSAR (real MEASURED_INSAR velocities)
# =============================================================================
# Why this and not CDSE/LiCSAR/EGMS: CDSE publishes SLC scenes only (no deformation
# product); COMET-LiCSAR's public tree 404s on its interferogram directories and its
# Nepal frames are 9-27 months stale; EGMS is Europe-only. HyP3 is the only source
# that will actually yield a measured LOS velocity over Nepal.
#
# Setup: create a free NASA Earthdata Login at https://urs.earthdata.nasa.gov/
# then generate a user token. Free tier = 8000 credits/month; each InSAR job costs
# credits, so the refresh run budgets against the cap and prioritises at-risk sites.
# Products are ready ~1 hour after submission, so this runs on the WEEKLY cadence,
# never inside the 30-minute physics loop.
HYP3_ENABLED=0
HYP3_API_URL=https://hyp3-api.asf.alaska.edu
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
HYP3_MONTHLY_CREDIT_BUDGET=8000
HYP3_MAX_JOBS_PER_RUN=20
HYP3_BASELINE_MAX_AGE_DAYS=30

# =============================================================================
# NDRRMA BIPAD incident portal — real ground-truth harvesting
# =============================================================================
BIPAD_ENABLED=0
BIPAD_API_URL=https://bipadportal.gov.np/api/v1/incident/

# =============================================================================
# Adaptive monsoon cadence throttle
# =============================================================================
MHEWS_ADAPTIVE_THROTTLE=1
CYCLE_INTERVAL_SEC=1800
MONSOON_CYCLE_INTERVAL_SEC=900
MONSOON_THROTTLE_RAIN_MM=150.0
